{
  "manifest_version": 2,
  "name": "Quick Answer for Claude",
  "version": "1.0.0",
  "description": "Markierten Text oder Screenshot-Bereiche an Claude schicken, kurze Antworten erhalten und per Tastenkürzel in Formularfelder einfügen.",
  "browser_specific_settings": {
    "gecko": {
      "id": "quick-answer-for-claude@tekomail.ch",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "<all_urls>",
    "tabs",
    "activeTab",
    "menus",
    "storage",
    "unlimitedStorage",
    "clipboardWrite",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["render.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "sidebar_action": {
    "default_title": "Claude Verlauf",
    "default_panel": "sidebar/sidebar.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "open_at_install": false
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "ask-selection": {
      "suggested_key": { "default": "Ctrl+Alt+A" },
      "description": "Markierten Text an Claude schicken"
    },
    "capture-region": {
      "suggested_key": { "default": "Ctrl+Alt+S" },
      "description": "Screenshot-Bereich auswählen und an Claude schicken"
    },
    "insert-answer": {
      "suggested_key": { "default": "Ctrl+Alt+V" },
      "description": "Aktuelle Antwort ins fokussierte Feld einfügen"
    },
    "_execute_sidebar_action": {
      "suggested_key": { "default": "Ctrl+Alt+H" },
      "description": "Verlauf-Sidebar ein-/ausblenden"
    }
  }
}
